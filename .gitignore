# Allowlist: ignore everything, then add back only source. Local logs, test reports, configs and
# machine-specific files can never be committed by accident.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/LICENSE
!/NOTICE.md
!/README.md
!/CONTRIBUTING.md
!/AGENTS.md
!/CLAUDE.md
!/install.ps1
!/selftest.ps1
!/docs/
/docs/*
!/docs/screenshots/
!/docs/brand/
!/docs/AI-GUIDE.md
!/src/
!/installer/
!/tools/

# build output / local
bin/
obj/
*.user
.vs/
node_modules/
/tools/*
!/tools/*.js
!/tools/package.json
!/tools/package-lock.json
